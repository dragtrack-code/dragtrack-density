      "Y22c": "cos(phi)**2 * cos(2*HA)",
      "Y22s": "cos(phi)**2 * sin(2*HA)",
      "Y30": "0.5*sin(phi)*(5*sin(phi)**2 - 3)",
      "Y31c": "1.5*cos(phi)*(5*sin(phi)**2 - 1)*cos(HA)",
      "Y31s": "1.5*cos(phi)*(5*sin(phi)**2 - 1)*sin(HA)",
      "Y32c": "15*sin(phi)*cos(phi)**2*cos(2*HA)",
      "Y32s": "15*sin(phi)*cos(phi)**2*sin(2*HA)",
      "Y33c": "15*cos(phi)**3*cos(3*HA)",
      "Y33s": "15*cos(phi)**3*sin(3*HA)"
    }
